# Скопируйте в .env и заполните. Файл .env не попадает в git.
NODE_ENV=production
PORT=4520
HOST=127.0.0.1
# Префикс, под которым кабинет открыт снаружи (https://stellarschool.ru/dekanat)
BASE_PATH=/dekanat
DATABASE_URL=postgres://dekanat:CHANGE_ME@127.0.0.1:5432/dekanat
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32 — ключ AES-256-GCM для шифрования персональных полей
DATA_KEY=
# 1, если перед приложением стоит обратный прокси (Caddy/nginx)
TRUST_PROXY=1
# 1 — cookie только по HTTPS
COOKIE_SECURE=1
TZ=Europe/Moscow
